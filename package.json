{
  "name": "ezai-marketplace",
  "version": "1.4.4",
  "description": "CLI to install AI skills from the ezai marketplace into Claude Code, Gemini CLI, and Copilot",
  "author": {
    "name": "Florian Salort",
    "email": "floriansalort@outlook.fr",
    "url": "https://github.com/neuraaak"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/neuraaak/ezai-marketplace.git"
  },
  "bugs": {
    "url": "https://github.com/neuraaak/ezai-marketplace/issues"
  },
  "homepage": "https://github.com/neuraaak/ezai-marketplace#readme",
  "files": [
    "bin/",
    "src/",
    "plugins/",
    ".claude-plugin/"
  ],
  "main": "src/catalogue.js",
  "bin": {
    "ezai": "./bin/ezai.js"
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint src/ bin/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build-index": "node scripts/build-index.js",
    "prepare": "node -e \"try{if(!process.env.CI)require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "release": "pnpm publish --access public --no-git-checks",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changelog": "git-cliff -o docs/changelog.md",
    "graphify:init": "node .scripts/run_graphify_init.js",
    "graphify:update": "node .scripts/run_graphify_update.js",
    "graphify:refresh": "node .scripts/run_graphify_refresh.js",
    "test:coverage": "jest --coverage"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "ai",
    "skills",
    "claude",
    "marketplace"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0",
    "pnpm": ">=11"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "vitepress": "^1.6.0",
    "vitepress-versioning-plugin": "^1.3.0"
  }
}
