{
  "name": "ezai-marketplace",
  "version": "1.1.0",
  "description": "CLI to install AI skills from the ezai marketplace into Claude Code, Gemini CLI, and Copilot",
  "author": {
    "name": "Florian Salort",
    "email": "floriansalort@outlook.fr",
    "url": "https://github.com/Neuraaak"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Neuraaak/ezai-marketplace.git"
  },
  "bugs": {
    "url": "https://github.com/Neuraaak/ezai-marketplace/issues"
  },
  "homepage": "https://github.com/Neuraaak/ezai-marketplace#readme",
  "files": [
    "bin/",
    "src/",
    "plugins/",
    ".claude-plugin/"
  ],
  "main": "src/catalogue.js",
  "bin": {
    "ezai": "./bin/ezai.js"
  },
  "scripts": {
    "test": "jest",
    "lint": "eslint src/ bin/",
    "build-index": "node scripts/build-index.js",
    "prepare": "husky",
    "release": "pnpm publish --access public --no-git-checks",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "ai",
    "skills",
    "claude",
    "marketplace"
  ],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "vitepress": "^1.6.0",
    "vitepress-versioning-plugin": "^1.3.0"
  }
}
