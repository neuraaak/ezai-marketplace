{
  "name": "ezai-marketplace",
  "version": "1.0.0",
  "description": "CLI pour installer des skills IA depuis le marketplace ezai",
  "files": [
    "bin/",
    "src/",
    "plugins/",
    ".claude-plugin/"
  ],
  "main": "src/catalogue.js",
  "bin": {
    "ezai": "./bin/ezai.js"
  },
  "scripts": {
    "test": "jest",
    "build-index": "node scripts/build-index.js",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/build-index.js && git add .claude-plugin/marketplace.json && npx lint-staged && npm test"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [
    "ai",
    "skills",
    "claude",
    "marketplace"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.0.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1"
  }
}
