{
  "name": "ezai-marketplace",
  "version": "1.8.1",
  "description": "CLI to install AI skills for Codex, Claude Code, Gemini CLI, Copilot, Vibe, and Kimi Code",
  "packageManager": "pnpm@11.22.0",
  "keywords": [
    "ai",
    "skills",
    "marketplace",
    "codex",
    "claude",
    "gemini",
    "copilot",
    "vibe",
    "kimi"
  ],
  "author": {
    "name": "Florian Salort",
    "email": "floriansalort@outlook.fr",
    "url": "https://github.com/neuraaak"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neuraaak/ezai-marketplace.git"
  },
  "homepage": "https://github.com/neuraaak/ezai-marketplace#readme",
  "bugs": {
    "url": "https://github.com/neuraaak/ezai-marketplace/issues"
  },
  "files": [
    "bin/",
    "src/",
    "plugins/",
    ".claude-plugin/"
  ],
  "main": "src/catalogue.js",
  "bin": {
    "ezai": "./bin/ezai.js"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "test": "jest",
    "lint": "biome lint .",
    "lint:security": "eslint src/ bin/",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build-index": "node scripts/build-index.js",
    "prepare": "node -e \"try{if(!process.env.CI)require('child_process').execSync('husky',{stdio:'inherit'})}catch(e){}\"",
    "release": "pnpm publish --access public --no-git-checks",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changelog": "git-cliff -o docs/changelog.md",
    "graphify:init": "node .scripts/run_graphify_init.js",
    "graphify:update": "node .scripts/run_graphify_update.js",
    "graphify:refresh": "node .scripts/run_graphify_refresh.js",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "eslint": "^10.4.0",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "lint-staged": "^17.0.5",
    "vitepress": "^1.6.0",
    "vitepress-versioning-plugin": "^1.3.0"
  },
  "lint-staged": {
    "*.js": [
      "biome check --write --no-errors-on-unmatched",
      "eslint"
    ],
    "*.{json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{md,yml,yaml}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  }
}
